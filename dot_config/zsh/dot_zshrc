# enables syntax highlighting for commands through a plugin
# source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# enables vim mode through a plugin
# source "$(brew --prefix)/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"

# required to move the cursor to eol when hitting up / down arrow key
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
# enables history search when pressing up / down arrow
bindkey "^[[A" history-beginning-search-backward-end
bindkey "^[[B" history-beginning-search-forward-end

bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[3~" delete-char

alias ls="ls -lH --color=auto"
alias grep="grep --color"
alias vim="nvim"

export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"
# Created by `pipx` on 2024-11-20 18:05:29
export PATH="$PATH:/Users/corvin/.local/bin"

if [[ "${widgets[zle-keymap-select]#user:}" == "starship_zle-keymap-select" || \
      "${widgets[zle-keymap-select]#user:}" == "starship_zle-keymap-select-wrapped" ]]; then
    zle -N zle-keymap-select "";
fi

# enables the starship rs prompt - config located in ~/.config/starship.toml
eval "$(starship init zsh)"

export CHEZMOI_SOURCE_DIR=$(chezmoi data | jq -r '.chezmoi.config.sourceDir')
