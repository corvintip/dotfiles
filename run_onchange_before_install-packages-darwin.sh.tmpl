#!/bin/sh

if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

{{ $installablePackages := includeTemplate "with-installable-packages" . | fromYaml -}}

brew bundle --file=/dev/stdin <<EOF
{{- range $pkg, $pkgMeta := $installablePackages }}
{{- if eq $pkgMeta.via "brew" }}
brew "{{$pkgMeta.pkgName}}"
{{- end -}}
{{- end }}
EOF
