#!/bin/sh

SUDO=$(command -v sudo)
if [ -z "$SUDO" ]; then
    echo "WARN: sudo missing" 
fi

$SUDO apt update

{{ $installablePackages := includeTemplate "with-installable-packages" . | fromYaml -}}

{{- range $pkg, $pkgMeta := $packages -}}
{{- if eq $pkgMeta.via "apt" -}}
$SUDO apt install -y "{{$pkgMeta.pkgName}}"
{{ end -}}
{{ end -}}
