{{- $root := . -}}

{{- if and (ne .chezmoi.os "darwin") (ne .chezmoi.os "linux") }}
set-default-shell.sh
{{ end -}}

{{- if ne .osid "darwin" }}
# ignore any darwin script
*-darwin.sh
{{ end -}}

{{- if ne .osid "linux_debian" }}
# ignore any debian script
*-debian.sh
{{ end -}}


# ignore install scripts for packages that:
# 1. are not configured to install via "script" for the target platform (chezmoidata.yaml)
# 2. are not part of the installable packages
{{ $installablePackages := includeTemplate "with-installable-packages" . | fromYaml -}}
{{- range $pkg, $pkgMeta := .packages -}}
{{- $installVia := dig $root.osid "via" nil $pkgMeta -}}
{{ if or (ne $installVia "script") (not (hasKey $installablePackages $pkg)) -}}
install-{{$pkg}}*
{{ end -}}
{{ end -}}


